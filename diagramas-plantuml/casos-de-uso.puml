@startuml
' Hotel Duerme Bien - Casos de uso principales
left to right direction
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 72
skinparam ranksep 100
skinparam ActorBorderColor #397D8F
skinparam ActorFontColor #244758
skinparam UsecaseBackgroundColor #F4FAFC
skinparam UsecaseBorderColor #397D8F
skinparam UsecaseFontColor #254455
skinparam RectangleBorderColor #869DAA
skinparam ArrowColor #647E8B
title Hotel Duerme Bien - Diagrama general de casos de uso
actor "Encargado de hotel" as Enc
actor "Administrador" as Admin

rectangle "Sistema de Pasajeros" {
  package "Operación del hotel" {
    usecase "Iniciar sesión" as Login
    usecase "Consultar ocupación\ny disponibilidad" as Disponibilidad
    usecase "Gestionar reservas" as Reservas
    usecase "Registrar y consultar huéspedes" as Huespedes
    usecase "Realizar check-in" as Checkin
    usecase "Realizar check-out" as Checkout
  }
  package "Administración" {
    usecase "Gestionar habitaciones" as Habitaciones
    usecase "Gestionar usuarios y roles" as Usuarios
    usecase "Consultar informes de\nocupación y reservas" as Informes
  }
}
Enc -- Login
Enc -- Disponibilidad
Enc -- Reservas
Enc -- Huespedes
Enc -- Checkin
Enc -- Checkout

Admin -- Habitaciones
Admin -- Usuarios
Admin -- Informes
Admin --|> Enc

note right of Admin
  El administrador hereda las operaciones del encargado.
  Permisos detallados propuestos; sujetos a validación.
end note
note bottom of Reservas
  Crear, modificar y cancelar reservas.
  Para detalles «include» y «extend»,
  consultar el segundo diagrama.
end note
@enduml
