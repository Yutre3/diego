@startuml
' Hotel Duerme Bien - Dependencias obligatorias y alternativa sin reserva
left to right direction
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 100
skinparam ActorBorderColor #397D8F
skinparam UsecaseBackgroundColor #F4FAFC
skinparam UsecaseBorderColor #397D8F
skinparam RectangleBorderColor #869DAA
skinparam ArrowColor #647E8B
title Hotel Duerme Bien - Relaciones include y extend
actor "Encargado de hotel" as Enc
rectangle "Sistema de Pasajeros" {
 usecase "Crear reserva" as Crear
 usecase "Realizar check-in" as Checkin
 usecase "Realizar check-out" as Checkout
 usecase "Consultar disponibilidad" as Disponible
 usecase "Identificar o registrar huésped" as Identificar
 usecase "Asignar habitación" as Asignar
 usecase "Ingreso sin reserva" as Directo
 usecase "Calcular costo por pasajero" as Calcular
 usecase "Liberar habitación" as Liberar
}
Enc -- Crear
Enc -- Checkin
Enc -- Checkout

Crear ..> Disponible : <<include>>
Checkin ..> Disponible : <<include>>
Checkin ..> Identificar : <<include>>
Checkin ..> Asignar : <<include>>
Directo ..> Checkin : <<extend>>\n[sin reserva previa]
Checkout ..> Calcular : <<include>>
Checkout ..> Liberar : <<include>>

note bottom of Crear
  Crear una reserva requiere verificar disponibilidad.
  Modificarla también necesita validar nuevos datos.
end note
note bottom of Directo
  El ingreso sin reserva es una alternativa
  prevista en el caso de estudio.
end note
@enduml
